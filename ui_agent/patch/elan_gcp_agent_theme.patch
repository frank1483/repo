+    // 媒體庫影片預覽區底（Prototype Media.png 取樣 #141F2E）
+    readonly property color mediaVideoBackground: "#141F2E"
+    // 地圖與 3D 畫布維持不透明背景，不套玻璃效果
+    readonly property color bgCanvas: "#0A0F12"
+    // 影像訊號尚未接通時的中性灰底，取自 Figma GCP/Flight/VideoSignalState。
+    readonly property color videoSignalBackground: neutral600
+
+    // 玻璃感面板：黑 60% + 背景模糊 24（GcpPanel 用；效能不足時退回 panelFallbackFill）
+    readonly property color panelFill: _agentColor("panelFill", Qt.rgba(0, 0, 0, 0.6))
+    readonly property color panelFallbackFill: _agentColor("panelFallbackFill", Qt.rgba(0, 0, 0, 0.8))
