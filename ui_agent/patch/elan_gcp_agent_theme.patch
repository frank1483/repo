+// GcpTheme.qml 的顏色分組，拆成具名元件讓 qmllint 能解析成員型別。
+QtObject {
+    property var _agentThemeGroups: ({})
+    readonly property var _agentThemeColors: AgentPalette.materialize(_agentThemeGroups)
+    // State owns transactions and policy validation. Do not call from model output.
+    function setAgentThemeGroups(groups) {
+        _agentThemeGroups = AgentPalette.checkedGroups(groups)
+    }
+    function _agentColor(name, fallback) {
+        const group = AgentPalette.tokenGroup(name)
+        if (!Object.prototype.hasOwnProperty.call(_agentThemeGroups, group)) return fallback
+        const value = _agentThemeColors[name]
+        return Qt.rgba(value.r, value.g, value.b, value.a)
+    }
+
+    // 主色（cyan-400）：強調文字、圖示、HUD 刻度與數值
