+    // 選中項目的內陰影 25% 與 3px 強調條光暈 80%（呼叫端自行套用透明度）
+    readonly property color selectionGlow: _agentColor("selectionGlow", "#06B6D4")
+
+    // 整頁背景（不透明）
+    readonly property color bgBase: _agentColor("bgBase", "#000000")
