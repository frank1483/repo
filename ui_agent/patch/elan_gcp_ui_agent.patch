+    // UI agent：目前畫面與子頁（子頁 = 各頁 selectedSection；飛行日誌為 currentView；沒有子頁為 -1）
+    function agentLocation() {
+        const item = root.currentPage === 1 ? null : pageLoader.item
+        let section = -1
+        if (item && root.currentPage === 6 && item.currentView !== undefined) section = item.currentView
+        else if (item && item.selectedSection !== undefined) section = item.selectedSection
+        return { page: root.currentPage, section: section }
+    }
+
+    // UI agent 換頁：沿用 navigateToPage 的權限檢查；系統設定受限子頁同樣不開放
+    function agentGoTo(page, section) {
+        if (page !== root.currentPage && !root.navigateToPage(page)) return false
+        if (section === undefined || section < 0) return true
+        const item = pageLoader.item
+        if (!item) return true
+        if (item._restrictedSectionIndices && item._restrictedSectionIndices.indexOf(section) >= 0) {
+            accessToast.showError(qsTr("目前帳號角色沒有此設定分頁的權限。"))
+            return false
+        }
+        if (page === 6 && item.currentView !== undefined) item.currentView = section
+        else if (item.selectedSection !== undefined) item.selectedSection = section
+        return true
+    }
+
